---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  /** 홈처럼 사진 위에서 시작하면 투명하게 시작해(흰 로고) 스크롤하면 흰 바탕(네이비 로고)이 된다 */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const links = [
  { label: '주요 활동', href: '/activities' },
  { label: '허브 백과사전', href: '/herb' },
  { label: '스토어', href: '/stores' },
  { label: '미디어', href: '/press' },
  { label: '자주 묻는 질문', href: '/faq' },
  { label: '문의', href: '/contact' },
];

const externalLinks = [
  { label: '스파 예약', href: 'https://spa.justkoreacorp.com/' },
  { label: '온라인 스토어', href: 'https://justkorea.co.kr/' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class:list={['header', { 'header--overlay': overlay }]} id="siteHeader">
  <div class="header__inner container">
    <a href="/" class="header__logo" aria-label="유스트코리아 홈">
      <Logo class="header__logo-svg" />
    </a>

    <nav class="header__nav" aria-label="주 메뉴">
      <ul class="header__list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="header__link" aria-current={isActive(link.href) ? 'page' : undefined} data-astro-prefetch="viewport">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="header__list header__list--ext">
        {
          externalLinks.map((link) => (
            <li>
              <a href={link.href} class="header__link header__link--ext" target="_blank" rel="noopener">
                {link.label}
                <Icon name="external" size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="header__menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mobileMenu">
      <span class="sr-only">메뉴</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav class="container mobile-menu__inner" aria-label="모바일 메뉴">
      <ul class="mobile-menu__list">
        {
          links.map((link, i) => (
            <li style={`--i:${i}`}>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} data-astro-prefetch="viewport">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mobile-menu__ext" style={`--i:${links.length}`}>
        {
          externalLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener">
                {link.label}
                <Icon name="external" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    color: var(--ink);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--line);
    transition:
      background-color 0.35s,
      box-shadow 0.35s,
      color 0.35s;
  }

  /* 사진 위에 겹쳐 시작 — 글자와 로고는 흰색 */
  .header--overlay {
    --logo-ink: #ffffff;
    position: fixed;
    inset: 0 0 auto;
    color: var(--white);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }

  .header--overlay.is-scrolled,
  .header--overlay.is-open {
    --logo-ink: #1e59ae;
    color: var(--ink);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  /* backdrop-filter 가 있으면 안의 position:fixed 메뉴가 헤더 높이에 갇힌다 — 열려 있을 때는 끈다 */
  .header.is-open {
    background: var(--white);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .header__logo {
    flex: none;
    margin-right: auto;
  }

  .header__logo :global(svg) {
    height: 52px;
    width: auto;
    margin-block: -4px;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .header__list--ext {
    padding-left: 1.25rem;
    border-left: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 22%, transparent);
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.7rem;
    font-size: var(--t-sm);
    font-weight: 550;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.15rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__link[aria-current='page'] {
    font-weight: 700;
  }

  .header__link--ext {
    opacity: 0.75;
  }

  .header__link--ext::after {
    display: none;
  }

  .header__link--ext:hover {
    opacity: 1;
  }

  /* 햄버거 */
  .header__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    align-items: center;
    justify-content: center;
  }

  .burger {
    position: relative;
    width: 22px;
    height: 10px;
  }

  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 0.4s var(--ease-out),
      top 0.4s var(--ease-out);
  }

  .burger span:first-child {
    top: 0;
  }

  .burger span:last-child {
    top: calc(100% - 1.6px);
  }

  .is-open .burger span:first-child {
    top: calc(50% - 0.8px);
    transform: rotate(45deg);
  }

  .is-open .burger span:last-child {
    top: calc(50% - 0.8px);
    transform: rotate(-45deg);
  }

  /* 모바일 메뉴 */
  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0;
    background: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu:not([hidden]) {
    animation: menu-in 0.35s var(--ease-out);
  }

  .mobile-menu__inner {
    padding-block: 1.5rem 3rem;
  }

  .mobile-menu__list {
    list-style: none;
  }

  .mobile-menu__list a {
    display: block;
    padding: 0.8rem 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu__list a[aria-current='page'] {
    color: var(--blue);
  }

  .mobile-menu__list li,
  .mobile-menu__ext {
    animation: menu-item 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 35ms + 60ms);
  }

  .mobile-menu__ext {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .mobile-menu__ext a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--t-sm);
    font-weight: 600;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (width <= 1100px) {
    .header__nav {
      display: none;
    }

    .header__menu-btn {
      display: inline-flex;
    }
  }

  @media (width <= 600px) {
    .header__logo :global(svg) {
      height: 44px;
    }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');

  const setOpen = (open: boolean) => {
    if (!header || !btn || !menu) return;
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('menu-open', open);
  };

  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      btn?.focus();
    }
  });
  matchMedia('(width > 1100px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
