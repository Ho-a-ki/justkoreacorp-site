---
// 하위 페이지 머리. 빨간 표식 + 큰 제목 + 설명, 필요하면 오른쪽(또는 아래)에 슬롯
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** 표식 옆에 붙는 짧은 위치 이름 (예: 허브 백과사전) */
  section?: string;
  back?: { href: string; label: string };
}
const { title, description, section, back } = Astro.props;
---

<section class="page-header">
  <div class="container page-header__inner">
    <div class="page-header__text">
      {
        back ? (
          <a href={back.href} class="page-header__back">
            <Icon name="arrow-left" size={16} />
            {back.label}
          </a>
        ) : (
          section && <p class="mark">{section}</p>
        )
      }
      <h1 class="page-header__title">{title}</h1>
      {description && <p class="page-header__desc">{description}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(60rem 18rem at 100% 0%, var(--blue-wash), transparent 70%),
      var(--white);
  }

  .page-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.75rem 3rem;
  }

  .page-header__text {
    max-width: 48rem;
  }

  .page-header__title {
    margin-top: 1rem;
    font-size: var(--t-title);
    font-weight: 800;
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }

  .page-header__desc {
    margin-top: 1.1rem;
    font-size: 1.25rem;
    color: var(--ink-2);
    max-width: 34em;
  }

  .page-header__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .page-header__back:hover {
    color: var(--blue);
  }

  .page-header__back:hover :global(.icon) {
    transform: translateX(-3px);
  }

  .page-header__back :global(.icon) {
    transition: transform 0.3s var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-header__text > * {
      animation: rise 0.7s var(--ease-out) both;
    }

    .page-header__text > :nth-child(2) {
      animation-delay: 60ms;
    }

    .page-header__text > :nth-child(3) {
      animation-delay: 120ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
