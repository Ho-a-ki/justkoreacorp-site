---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { thumbOf } from '../lib/images.mjs';

// 노션 위키 「유스트코리아 찾아오시는 길」 에서 옮김
const routes = [
  {
    station: '수내역',
    walk: '도보 10~15분',
    stop: '정자사거리',
    buses: '220 · 117 · 310 · 370',
  },
  {
    station: '정자역',
    stop: '정자역.정자1동 주민센터 (2번 출구 앞)',
    buses: '220 · 117',
  },
];

const groups = [
  {
    title: '둘러보기',
    links: [
      { label: '주요 활동', href: '/activities' },
      { label: '허브 백과사전', href: '/herb' },
      { label: '스토어', href: '/stores' },
      { label: '미디어', href: '/press' },
    ],
  },
  {
    title: '도움',
    links: [
      { label: '자주 묻는 질문', href: '/faq' },
      { label: '제품 상담 (채팅)', href: 'https://happytalk.io/l/quU0Cb', external: true },
      { label: '협업 문의', href: '/contact' },
    ],
  },
  {
    title: 'JUST 바깥으로',
    links: [
      { label: '스파 예약', href: 'https://spa.justkoreacorp.com/', external: true },
      { label: '온라인 스토어', href: 'https://justkorea.co.kr', external: true },
      { label: '인스타그램', href: 'https://www.instagram.com/justkorea_official/', external: true },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo class="footer__logo" />
        <p>스위스 알프스의 허브를 담은 올케어 코스메틱.<br />1930년 아펜첼에서 시작한 JUST의 한국 공식 법인입니다.</p>
      </div>

      {
        groups.map((group) => (
          <nav class="footer__group" aria-label={group.title}>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener' : undefined}
                  >
                    {link.label}
                    {link.external && <Icon name="external" size={13} />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <section class="footer__map" aria-labelledby="footer-map-title">
      <div class="footer__map-head">
        <h2 id="footer-map-title"><Icon name="pin" size={15} /> 찾아오시는 길</h2>
        <p>경기도 성남시 분당구 백현로 26, 힐튼호텔 레지던스동 2층</p>
      </div>

      <ul class="footer__routes">
        {
          routes.map((r) => (
            <li>
              <h3>
                {r.station} 하차{r.walk && <span> → {r.walk}</span>}
              </h3>
              <p>
                버스: <strong>{r.stop}</strong> 정류장에서 <strong>{r.buses}</strong>번 탑승 →{' '}
                <strong>한국잡월드</strong> 하차 후 도보 약 5분
              </p>
            </li>
          ))
        }
        <li>
          <h3>건물 안에서</h3>
          <p>
            레지던스동 입구 2곳 중 왼쪽 입구는 바로 엘리베이터로, 오른쪽 입구는 들어와서 왼쪽 문을 지나
            엘리베이터로 2층. 내리면 바로 왼쪽 <strong>남색 문(Office)</strong>입니다.
          </p>
        </li>
      </ul>

      <details class="footer__photos">
        <summary>지도·입구 사진 보기</summary>
        <div>
          <figure>
            <img src={thumbOf('/images/location/walk-route.png')} alt="한국잡월드 정류장에서 힐튼 레지던스동까지 도보 경로 지도" width="1022" height="832" loading="lazy" decoding="async" />
            <figcaption>한국잡월드 정류장에서 걷는 길 (220번 기준 약 10분 간격)</figcaption>
          </figure>
          <figure>
            <img src={thumbOf('/images/location/entrance.png')} alt="레지던스동 입구 두 곳이 표시된 건물 사진" width="682" height="475" loading="lazy" decoding="async" />
            <figcaption>레지던스동 입구 2곳 (빨간 표시)</figcaption>
          </figure>
        </div>
      </details>
    </section>

    <div class="footer__info">
      <address>
        <span>(주)유스트코리아</span>
        <span>대표 임순채</span>
        <span>사업자등록번호 261-81-02131</span>
        <span>경기도 성남시 분당구 백현로 26, 힐튼 레지던스 2층</span>
        <a href="tel:02-3482-4056">02-3482-4056</a>
        <a href="mailto:hq@justkorea.co.kr">hq@justkorea.co.kr</a>
      </address>
      <div class="footer__legal">
        <p>© {new Date().getFullYear()} JUST Korea</p>
        <a href="/terms">이용약관</a>
        <a href="/privacy"><strong>개인정보처리방침</strong></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    --logo-ink: #ffffff;
    background: var(--blue-deep);
    color: rgb(255 255 255 / 0.72);
    font-size: var(--t-sm);
    padding-top: clamp(3.5rem, 2rem + 4vw, 5.5rem);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .footer__brand :global(.footer__logo) {
    height: 64px;
    width: auto;
    margin: -6px 0 1rem -4px;
  }

  .footer__brand p {
    max-width: 22rem;
    line-height: 1.7;
  }

  .footer__group h2 {
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--white);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .footer__group ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .footer__group a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s;
  }

  .footer__group a:hover,
  .footer__info a:hover {
    color: var(--white);
  }

  .footer__map {
    display: grid;
    grid-template-columns: 1.6fr 3fr;
    gap: 1.25rem 2.5rem;
    padding-block: 2.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .footer__map-head h2 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--white);
    margin-bottom: 0.6rem;
  }

  .footer__map-head p {
    line-height: 1.6;
  }

  .footer__routes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .footer__routes h3 {
    font-size: var(--t-sm);
    font-weight: 600;
    color: rgb(255 255 255 / 0.9);
    margin-bottom: 0.4rem;
  }

  .footer__routes h3 span {
    font-weight: 400;
    color: rgb(255 255 255 / 0.6);
  }

  .footer__routes p {
    font-size: var(--t-xs);
    line-height: 1.7;
  }

  .footer__routes strong {
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  .footer__photos {
    grid-column: 2;
    font-size: var(--t-xs);
  }

  .footer__photos summary {
    cursor: pointer;
    width: fit-content;
    color: rgb(255 255 255 / 0.8);
    transition: color 0.2s;
  }

  .footer__photos summary:hover {
    color: var(--white);
  }

  .footer__photos > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .footer__photos img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.06);
  }

  .footer__photos figcaption {
    margin-top: 0.45rem;
    color: rgb(255 255 255 / 0.55);
  }

  .footer__info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: var(--t-xs);
    color: rgb(255 255 255 / 0.55);
  }

  .footer__info address {
    font-style: normal;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    max-width: 52rem;
  }

  .footer__legal {
    display: flex;
    gap: 1.1rem;
  }

  .footer__legal strong {
    font-weight: 650;
    color: rgb(255 255 255 / 0.8);
  }

  @media (width <= 900px) {
    .footer__top {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__map {
      grid-template-columns: 1fr;
    }

    .footer__photos {
      grid-column: auto;
    }
  }

  @media (width <= 560px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__routes,
    .footer__photos > div {
      grid-template-columns: 1fr;
    }
  }
</style>
