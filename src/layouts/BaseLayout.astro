---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 첫 화면이 사진 위에서 시작하는 페이지(홈). 헤더가 투명하게 시작한다 */
  overlayHeader?: boolean;
}

const {
  title,
  description = '1930년 스위스 아펜첼에서 시작한 허브 코스메틱 JUST의 한국 공식 법인, 유스트코리아입니다.',
  image = '/images/hero/banner.jpg',
  overlayHeader = false,
} = Astro.props;

const fullTitle = title ? `${title} | 유스트코리아` : '유스트코리아 — 스위스 알프스 허브 코스메틱 JUST';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1e59ae" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="유스트코리아" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* ── 토큰 ─────────────────────────────────────────── */
  :root {
    --blue: #1e59ae; /* 브랜드 네이비 — 로고 글자색 */
    --blue-deep: #17488f;
    --blue-wash: #e8eef8;
    --ink: #0f2236; /* 본문 글자 */
    --ink-2: #4a5c6e; /* 보조 글자 */
    --ink-3: #7b8a99;
    --snow: #f4f7f8; /* 면 배경 */
    --white: #ffffff;
    --line: #d8e0e6;
    --red: #ee2722; /* 로고의 빨간 사각형 — 표식에만 */
    --herb: #3d6b50; /* 허브·스파 표시에만 */
    --herb-wash: #e8f0ea;

    --font: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;

    /* 1.25 비율 타입 스케일 */
    --t-xs: 0.8125rem;
    --t-sm: 0.9375rem;
    --t-md: 1.0625rem;
    --t-lg: 1.3125rem;
    --t-xl: clamp(1.5rem, 1.1rem + 1.4vw, 2.125rem);
    --t-2xl: clamp(2rem, 1.3rem + 2.6vw, 3.375rem);
    --t-3xl: clamp(2.5rem, 1.2rem + 5.2vw, 5.5rem);

    --gutter: clamp(1rem, 0.4rem + 2.6vw, 2.5rem);
    --max: 1240px;
    --nav-h: 72px;
    --section: clamp(4.5rem, 3rem + 6vw, 8.5rem);

    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --r-sm: 3px;
    --r-md: 6px;
  }

  /* ── 기본 ─────────────────────────────────────────── */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-padding-top: calc(var(--nav-h) + 1rem);
    interpolate-size: allow-keywords;
  }

  body {
    font-family: var(--font);
    font-size: var(--t-md);
    font-weight: 400;
    line-height: 1.75;
    color: var(--ink);
    background: var(--white);
    -webkit-font-smoothing: antialiased;
    word-break: keep-all;
    overflow-wrap: anywhere;
    font-feature-settings: 'ss06';
  }

  body.menu-open {
    overflow: hidden;
  }

  h1,
  h2,
  h3,
  h4 {
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  img {
    height: auto;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  button {
    cursor: pointer;
    background: none;
    border: 0;
  }

  ::selection {
    background: var(--blue);
    color: var(--white);
  }

  :focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--r-sm);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── 레이아웃 ─────────────────────────────────────── */
  .container {
    width: 100%;
    max-width: calc(var(--max) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .section {
    padding-block: var(--section);
  }

  .section--snow {
    background: var(--snow);
  }

  /* 빨간 사각 표식: 로고의 스위스 십자 사각형에서 가져온 유일한 강조 */
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }

  .mark::before {
    content: '';
    width: 0.62em;
    height: 0.62em;
    background: var(--red);
    flex: none;
    transform: skewX(-10deg);
  }

  .heading {
    font-size: var(--t-2xl);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.18;
  }

  .lede {
    font-size: var(--t-lg);
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 38em;
  }

  /* ── 버튼 ─────────────────────────────────────────── */
  .btn {
    --btn-bg: var(--blue);
    --btn-fg: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: var(--t-sm);
    font-weight: 650;
    letter-spacing: -0.01em;
    border: 1px solid transparent;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .btn .icon {
    transition: transform 0.35s var(--ease-out);
  }

  .btn:hover {
    --btn-bg: var(--blue-deep);
  }

  .btn:hover .icon {
    transform: translateX(3px);
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    border-color: var(--line);
  }

  .btn--ghost:hover {
    --btn-bg: transparent;
    border-color: var(--ink);
  }

  .btn--light {
    --btn-bg: var(--white);
    --btn-fg: var(--blue);
  }

  .btn--light:hover {
    --btn-bg: var(--blue-wash);
  }

  .btn--glass {
    --btn-bg: rgb(255 255 255 / 0.12);
    --btn-fg: var(--white);
    border-color: rgb(255 255 255 / 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .btn--glass:hover {
    --btn-bg: rgb(255 255 255 / 0.22);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 650;
    color: var(--blue);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }

  .text-link:hover {
    background-size: 100% 1px;
  }

  /* ── 칩 (필터) ───────────────────────────────────── */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 1.05rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-size: var(--t-sm);
    font-weight: 550;
    color: var(--ink-2);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .chip:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .chip[aria-pressed='true'],
  .chip[aria-current='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .chip__count {
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  /* ── 검색 입력 ───────────────────────────────────── */
  .search {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 30rem;
    width: 100%;
  }

  .search .icon {
    position: absolute;
    left: 1.1rem;
    color: var(--ink-3);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0 1.25rem 0 3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-size: var(--t-md);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .search input::placeholder {
    color: var(--ink-3);
  }

  .search input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(30 89 174 / 0.12);
  }

  .search input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .empty-state {
    padding: 3rem 0;
    color: var(--ink-2);
  }

  .empty-state strong {
    display: block;
    color: var(--ink);
    font-size: var(--t-lg);
    margin-bottom: 0.25rem;
  }

  /* ── 본문 (마크다운) ─────────────────────────────── */
  .prose {
    max-width: 44rem;
    font-size: var(--t-md);
    line-height: 1.85;
    color: var(--ink);
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  .prose h2 {
    font-size: var(--t-xl);
    margin-top: 2.2em;
  }

  .prose h3 {
    font-size: var(--t-lg);
    margin-top: 2em;
  }

  .prose h4 {
    font-size: var(--t-md);
    margin-top: 1.8em;
    color: var(--blue);
  }

  .prose h2 + *,
  .prose h3 + *,
  .prose h4 + * {
    margin-top: 0.6em;
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose strong {
    font-weight: 700;
  }

  .prose a {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    word-break: break-all;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }

  .prose li + li {
    margin-top: 0.35em;
  }

  .prose li::marker {
    color: var(--ink-3);
  }

  .prose img {
    width: 100%;
    border-radius: var(--r-md);
    margin-block: 0.75em;
  }

  .prose p:has(> img:only-child) {
    margin-block: 2em;
  }

  /* 노션 callout 이 인용(>) 블록으로 바뀌었다 — 강조 상자로 보여 준다 */
  .prose blockquote {
    padding: 1.15em 1.4em;
    background: var(--snow);
    border-left: 3px solid var(--blue);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }

  .prose blockquote > * + * {
    margin-top: 0.7em;
  }

  .prose blockquote + blockquote {
    margin-top: 0.75em;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    padding: 0.7em 0.9em;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    font-weight: 650;
    background: var(--snow);
    white-space: nowrap;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2.5em;
  }

  .prose code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    background: var(--snow);
    border-radius: var(--r-sm);
  }

  /* ── 모션 ─────────────────────────────────────────── */
  /* 페이지 이동: 문서 사이 View Transition (지원하는 브라우저에서만) */
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.35s;
    animation-timing-function: var(--ease-out);
  }

  /* 스크롤로 드러나는 요소 — 지원 브라우저에서만, 한 번에 한 무리만 쓴다 */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 28%;
      }
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(2.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    @view-transition {
      navigation: none;
    }
  }
</style>
