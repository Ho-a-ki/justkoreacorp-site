---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getFaqGroups } from '../lib/content';

const groups = await getFaqGroups();
const total = groups.reduce((n, g) => n + g.items.length, 0);

// 질문마다 본문을 미리 렌더하고, 검색용 글자도 만든다
const rendered = await Promise.all(
  groups.map(async (g, gi) => ({
    ...g,
    anchor: `cat-${gi + 1}`,
    items: await Promise.all(
      g.items.map(async (item) => ({
        item,
        Content: (await render(item)).Content,
        text: `${item.data.question} ${(item.body ?? '').replace(/!\[[^\]]*\]\([^)]*\)|[#>*_`|\-\[\]()]/g, ' ')}`.replace(/\s+/g, ' '),
      })),
    ),
  })),
);
---

<BaseLayout title="자주 묻는 질문" description="제품 사용법과 성분, 안전성까지 유스트에 대해 자주 묻는 질문과 답변입니다.">
  <PageHeader section="자주 묻는 질문" title="무엇이 궁금하세요?" description={`제품 사용법부터 성분, 안전성까지 ${total}가지 질문에 답했습니다.`}>
    <label class="search" data-faq-search>
      <Icon name="search" />
      <span class="sr-only">질문과 답변에서 찾기</span>
      <input type="search" placeholder="예: 임산부, 보관, 백노삼" autocomplete="off" />
    </label>
  </PageHeader>

  <section class="section faq">
    <div class="container faq__grid">
      <nav class="faq__nav" aria-label="분류">
        <ul>
          {
            rendered.map((g) => (
              <li>
                <a href={`#${g.anchor}`} data-cat-link={g.anchor}>
                  {g.category}
                  <span class="chip__count">{g.items.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="faq__body">
        <p class="faq__result" aria-live="polite" data-faq-result hidden></p>
        {
          rendered.map((g) => (
            <section class="faq-group" id={g.anchor} data-faq-group>
              <h2>{g.category}</h2>
              <div class="faq-group__list">
                {g.items.map(({ item, Content, text }) => (
                  <details class="qa" id={item.id} data-text={text}>
                    <summary>
                      <span class="qa__q">{item.data.question}</span>
                      <span class="qa__icon" aria-hidden="true">
                        <Icon name="plus" size={20} />
                      </span>
                    </summary>
                    <div class="qa__a">
                      <div class="prose">
                        <Content />
                      </div>
                      <button class="qa__copy" type="button" data-copy={item.id}>
                        이 답변 링크 복사
                      </button>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
        <div class="empty-state" data-faq-empty hidden>
          <strong>맞는 질문을 찾지 못했습니다</strong>
          다른 낱말로 찾아보거나, 아래 채팅 상담으로 바로 물어보세요.
        </div>

        <aside class="faq__help">
          <h2>여기 없는 질문이 있다면</h2>
          <p>피부 상태나 제품 고르기처럼 사람마다 다른 질문은 채팅으로 상담해 드립니다.</p>
          <a href="https://happytalk.io/l/quU0Cb" class="btn" target="_blank" rel="noopener"><Icon name="chat" size={18} /> 채팅 상담 열기</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq {
    padding-top: 3rem;
  }

  .faq__grid {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .faq__nav {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .faq__nav ul {
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .faq__nav a {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-left: -1px;
    padding: 0.5rem 0 0.5rem 1rem;
    border-left: 2px solid transparent;
    font-size: var(--t-sm);
    font-weight: 550;
    color: var(--ink-2);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .faq__nav a:hover {
    color: var(--ink);
  }

  .faq__nav a[aria-current='true'] {
    color: var(--blue);
    border-left-color: var(--blue);
    font-weight: 700;
  }

  .faq__result {
    margin-bottom: 1.5rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .faq-group {
    scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }

  .faq-group + .faq-group {
    margin-top: 3.5rem;
  }

  .faq-group h2 {
    font-size: var(--t-xl);
    font-weight: 750;
    letter-spacing: -0.04em;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--ink);
  }

  .qa {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--nav-h) + 1.5rem);
  }

  .qa summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa__q {
    font-size: var(--t-lg);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.5;
    transition: color 0.2s;
  }

  .qa summary:hover .qa__q,
  .qa[open] .qa__q {
    color: var(--blue);
  }

  .qa__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: -0.1rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .qa[open] .qa__icon {
    transform: rotate(45deg);
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white);
  }

  /* 펼침 — 지원 브라우저에서는 높이가 부드럽게 바뀐다 */
  .qa::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }

  .qa[open]::details-content {
    block-size: auto;
  }

  .qa__a {
    padding: 0 3.75rem 1.75rem 0;
  }

  .qa__a .prose {
    font-size: var(--t-md);
  }

  .qa__copy {
    margin-top: 1.25rem;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .qa__copy:hover {
    color: var(--blue);
  }

  .faq__help {
    margin-top: 4.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--snow);
    border-radius: var(--r-md);
  }

  .faq__help h2 {
    font-size: var(--t-xl);
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .faq__help p {
    margin: 0.4rem 0 1.5rem;
    color: var(--ink-2);
  }


  [hidden] {
    display: none !important;
  }

  @media (width <= 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }

    .faq__nav {
      position: static;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .faq__nav ul {
      display: flex;
      gap: 0.5rem;
      border: 0;
      width: max-content;
    }

    .faq__nav a {
      margin: 0;
      padding: 0.45rem 1rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      white-space: nowrap;
    }

    .faq__nav a[aria-current='true'] {
      border-color: var(--blue);
    }

    .qa__a {
      padding-right: 0;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-faq-search] input');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
  const items = [...document.querySelectorAll<HTMLDetailsElement>('details.qa')];
  const result = document.querySelector<HTMLElement>('[data-faq-result]');
  const empty = document.querySelector<HTMLElement>('[data-faq-empty]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]')];

  const normalize = (s: string) => s.replace(/\s+/g, '').toLowerCase();

  // 검색: 질문과 답변을 함께 찾고, 하나뿐이면 펼친다
  const search = () => {
    const q = normalize(input?.value ?? '');
    let shown = 0;
    for (const d of items) {
      const hit = !q || normalize(d.dataset.text ?? '').includes(q);
      d.hidden = !hit;
      if (hit) shown++;
    }
    groups.forEach((g) => (g.hidden = [...g.querySelectorAll<HTMLElement>('details.qa')].every((d) => d.hidden)));
    if (result) {
      result.hidden = !q;
      result.textContent = q ? `'${input?.value.trim()}'에 맞는 질문 ${shown}개` : '';
    }
    if (empty) empty.hidden = shown > 0;
    if (q && shown === 1) items.find((d) => !d.hidden)?.setAttribute('open', '');
  };
  input?.addEventListener('input', search);

  // 주소 끝의 #질문id 로 들어오면 그 답을 펼친다
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // 링크 복사
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    const url = `${location.origin}${location.pathname}#${btn.dataset.copy}`;
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = '링크를 복사했습니다';
    } catch {
      history.replaceState(null, '', `#${btn.dataset.copy}`);
      btn.textContent = '주소창의 링크를 복사하세요';
    }
    setTimeout(() => (btn.textContent = '이 답변 링크 복사'), 2200);
  });

  // 지금 보고 있는 분류 표시
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.catLink === entry.target.id)));
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  groups.forEach((g) => io.observe(g));
</script>
