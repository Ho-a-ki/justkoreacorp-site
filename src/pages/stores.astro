---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import data from '../data/stores.json';

const stores = data.stores;
const tags = [...new Set(stores.map((s) => s.tag).filter(Boolean))];
const spaCount = stores.filter((s) => s.spa).length;
const mapUrl = (s: (typeof stores)[number]) =>
  `https://map.naver.com/p/search/${encodeURIComponent(s.address ? `${s.address} 유스트` : `유스트 ${s.name}`)}`;
---

<BaseLayout title="스토어" description={`전국 ${stores.length}곳의 유스트 매장 위치와 전화번호입니다.`}>
  <PageHeader
    section="스토어"
    title="가까운 매장 찾기"
    description={`직영점과 백화점까지 전국 ${stores.length}곳에서 JUST를 직접 써 보고 상담받을 수 있습니다.`}
  >
    <label class="search" data-store-search>
      <Icon name="search" />
      <span class="sr-only">매장 이름이나 지역으로 찾기</span>
      <input type="search" placeholder="지역이나 매장 이름 (예: 판교, 부산)" autocomplete="off" />
    </label>
  </PageHeader>

  <section class="section stores">
    <div class="container">
      <div class="stores__filters">
        <div class="chips" role="group" aria-label="매장 구분" data-store-tags>
          <button class="chip" aria-pressed="true" data-tag="">전체 <span class="chip__count">{stores.length}</span></button>
          {
            tags.map((t) => (
              <button class="chip" aria-pressed="false" data-tag={t}>
                {t} <span class="chip__count">{stores.filter((s) => s.tag === t).length}</span>
              </button>
            ))
          }
        </div>
        {
          spaCount > 0 && (
            <label class="spa-toggle">
              <input type="checkbox" data-store-spa />
              <span class="spa-toggle__track" aria-hidden="true" />
              스파가 있는 매장만 <span class="chip__count">{spaCount}</span>
            </label>
          )
        }
      </div>

      <p class="stores__count" aria-live="polite" data-store-count>{stores.length}곳</p>

      <ul class="store-list" data-store-list>
        {
          stores.map((s) => (
            <li data-tag={s.tag} data-spa={s.spa ? '1' : ''} data-text={`${s.name} ${s.address} ${s.tag}`}>
              <div class="store">
                <div class="store__head">
                  <h2>{s.name}</h2>
                  <div class="store__badges">
                    {s.tag && <span class="badge">{s.tag}</span>}
                    {s.spa && <span class="badge badge--spa">스파</span>}
                  </div>
                </div>
                {s.address && <p class="store__addr">{s.address}</p>}
                <div class="store__actions">
                  {s.phone && (
                    <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`} class="store__btn">
                      <Icon name="phone" size={16} />
                      {s.phone}
                    </a>
                  )}
                  <a href={mapUrl(s)} class="store__btn" target="_blank" rel="noopener">
                    <Icon name="pin" size={16} />
                    지도
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="empty-state" data-store-empty hidden>
        <strong>조건에 맞는 매장이 없습니다</strong>
        검색어를 줄이거나 다른 구분을 눌러 보세요.
      </div>

      <aside class="stores__online">
        <div>
          <h2>근처에 매장이 없다면</h2>
          <p>온라인 스토어에서 같은 제품을 살 수 있고, 제품 상담은 채팅으로 받을 수 있습니다.</p>
        </div>
        <div class="stores__online-actions">
          <a href="https://justkorea.co.kr/" class="btn" target="_blank" rel="noopener">온라인 스토어 <Icon name="external" size={16} /></a>
          <a href="https://happytalk.io/l/quU0Cb" class="btn btn--ghost" target="_blank" rel="noopener"><Icon name="chat" size={16} /> 채팅 상담</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .stores {
    padding-top: 2.5rem;
  }

  .stores__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .spa-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-sm);
    font-weight: 550;
    color: var(--ink-2);
    cursor: pointer;
  }

  .spa-toggle input {
    position: absolute;
    opacity: 0;
  }

  .spa-toggle__track {
    position: relative;
    width: 2.6rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--line);
    transition: background-color 0.25s;
  }

  .spa-toggle__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(1.5rem - 6px);
    height: calc(1.5rem - 6px);
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    transition: transform 0.3s var(--ease-out);
  }

  .spa-toggle input:checked + .spa-toggle__track {
    background: var(--herb);
  }

  .spa-toggle input:checked + .spa-toggle__track::after {
    transform: translateX(1.1rem);
  }

  .spa-toggle input:focus-visible + .spa-toggle__track {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .stores__count {
    margin-top: 2rem;
    font-size: var(--t-sm);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .store-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    margin-top: 1rem;
    border-top: 2px solid var(--ink);
  }

  .store-list li {
    border-bottom: 1px solid var(--line);
  }

  .store {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .store-list li:nth-child(n) .store {
    padding-left: 0;
  }

  .store__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .store__head h2 {
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .store__badges {
    display: flex;
    gap: 0.3rem;
    flex: none;
  }

  .badge {
    font-size: var(--t-xs);
    font-weight: 600;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .badge--spa {
    border-color: transparent;
    background: var(--herb-wash);
    color: var(--herb);
  }

  .store__addr {
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .store__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .store__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--t-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.2s,
      color 0.2s,
      background-color 0.2s;
  }

  .store__btn:hover {
    border-color: var(--blue);
    color: var(--blue);
    background: var(--blue-wash);
  }

  .stores__online {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: 4rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--snow);
    border-radius: var(--r-md);
  }

  .stores__online h2 {
    font-size: var(--t-xl);
    font-weight: 750;
    letter-spacing: -0.04em;
  }

  .stores__online p {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }

  .stores__online-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (width > 700px) {
    .store-list {
      column-gap: 2.5rem;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-store-search] input');
  const spa = document.querySelector<HTMLInputElement>('[data-store-spa]');
  const tagGroup = document.querySelector('[data-store-tags]');
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-store-tags] .chip')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-store-list] > li')];
  const count = document.querySelector('[data-store-count]');
  const empty = document.querySelector<HTMLElement>('[data-store-empty]');
  let tag = '';

  const normalize = (s: string) => s.replace(/\s+/g, '').toLowerCase();

  const apply = () => {
    const q = normalize(input?.value ?? '');
    let shown = 0;
    for (const li of items) {
      const hit =
        (!tag || li.dataset.tag === tag) &&
        (!spa?.checked || li.dataset.spa === '1') &&
        (!q || normalize(li.dataset.text ?? '').includes(q));
      li.hidden = !hit;
      if (hit) shown++;
    }
    if (count) count.textContent = shown === items.length ? `${items.length}곳` : `${items.length}곳 중 ${shown}곳`;
    if (empty) empty.hidden = shown > 0;
  };

  tagGroup?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!btn) return;
    tag = btn.dataset.tag ?? '';
    tagButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    apply();
  });
  input?.addEventListener('input', apply);
  spa?.addEventListener('change', apply);
  apply();
</script>
