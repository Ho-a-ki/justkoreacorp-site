---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPress, getCeleb, coverOf, formatDate, isoDate, neighbors, startsWithCover, youtubeIdOf, vt, displayName } from '../../lib/content';

export async function getStaticPaths() {
  const [press, celeb] = await Promise.all([getPress(), getCeleb()]);
  return [
    ...press.map((item) => ({ params: { id: item.id }, props: { item, list: press, kind: '언론 보도' } })),
    ...celeb.map((item) => ({ params: { id: item.id }, props: { item, list: celeb, kind: 'JUST를 쓰는 셀럽' } })),
  ];
}

const { item, list, kind } = Astro.props;
const { Content } = await render(item);
const cover = coverOf(item);
const video = youtubeIdOf(item.body);
const { prev, next } = neighbors(list, item.id);
const hideFirstImage = startsWithCover(item);
---

<BaseLayout title={displayName(item.data.name)} description={`${displayName(item.data.name)} — JUST가 소개된 ${kind}`} image={cover || undefined}>
  <article class="article">
    <header class="container article__head">
      <a href="/press" class="article__back"><Icon name="arrow-left" size={16} /> 미디어</a>
      <p class="mark">{kind}</p>
      <h1 class="article__title">{displayName(item.data.name)}</h1>
      <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
    </header>

    <div class="container article__body">
      {
        video ? (
          <div class="article__video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video}`}
              title={`${item.data.name} 영상`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        ) : (
          cover &&
          hideFirstImage && (
            <figure class="article__cover" style={`view-transition-name:${vt('media', item.id)}`}>
              <img src={cover} alt="" decoding="async" />
            </figure>
          )
        )
      }
      <div class:list={['prose', { 'hide-first-image': hideFirstImage && !video }]}>
        <Content />
      </div>
      {
        item.data.url && (
          <a href={item.data.url} class="btn article__out" target="_blank" rel="noopener">
            원문 보러 가기 <Icon name="external" size={16} />
          </a>
        )
      }
    </div>

    <nav class="container pager" aria-label={`다른 ${kind}`}>
      {
        prev ? (
          <a href={`/press/${prev.id}`} class="pager__link">
            <span>최신 글</span>
            <strong>{displayName(prev.data.name)}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/press/${next.id}`} class="pager__link pager__link--next">
            <span>이전 글</span>
            <strong>{displayName(next.data.name)}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) var(--section);
  }

  .article__head,
  .article__body,
  .pager {
    max-width: calc(46rem + var(--gutter) * 2);
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 2rem;
  }

  .article__back:hover {
    color: var(--blue);
  }

  .article__title {
    margin-top: 0.9rem;
    font-size: var(--t-2xl);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .article__head time {
    display: block;
    margin-top: 1rem;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }

  .article__body {
    margin-top: 2.5rem;
  }

  .article__cover,
  .article__video {
    margin-bottom: 2.5rem;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--snow);
  }

  .article__cover img {
    width: 100%;
  }

  .article__video {
    aspect-ratio: 16 / 9;
  }

  .article__video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .article__out {
    margin-top: 2.5rem;
  }

  .hide-first-image > :global(p:first-child:has(> img:only-child)) {
    display: none;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: var(--section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pager__link {
    display: grid;
    gap: 0.15rem;
    max-width: 48%;
  }

  .pager__link span {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .pager__link strong {
    font-weight: 650;
    line-height: 1.5;
    transition: color 0.2s;
  }

  .pager__link:hover strong {
    color: var(--blue);
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }
</style>
