---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getHerbs, coverOf, vt } from '../../lib/content';

const herbs = await getHerbs();
---

<BaseLayout title="허브 백과사전" description={`JUST 제품에 담긴 허브와 원료 ${herbs.length}가지를 소개합니다.`}>
  <PageHeader
    section="허브 백과사전"
    title="병 속에 담긴 원료들"
    description={`JUST 제품에 들어가는 허브와 원료 ${herbs.length}가지의 이야기입니다. 이름으로 찾아보세요.`}
  >
    <label class="search" data-herb-search>
      <Icon name="search" />
      <span class="sr-only">허브 이름으로 찾기</span>
      <input type="search" placeholder="예: 에델바이스, 라벤더" autocomplete="off" />
    </label>
  </PageHeader>

  <section class="section herbs">
    <div class="container">
      <p class="herbs__count" aria-live="polite" data-herb-count>{herbs.length}가지</p>
      <ul class="herbs__grid" data-herb-list>
        {
          herbs.map((herb) => {
            const cover = coverOf(herb);
            return (
              <li data-name={herb.data.name}>
                <a href={`/herb/${herb.id}`} class="herb-card">
                  <div class="herb-card__img" style={`view-transition-name:${vt('herb', herb.id)}`}>
                    {cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <Icon name="leaf" size={32} />}
                  </div>
                  <div class="herb-card__body">
                    <h2>{herb.data.name}</h2>
                    {herb.data.tags.length > 0 && (
                      <ul class="herb-card__tags">
                        {herb.data.tags.map((t) => (
                          <li>{t}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="empty-state" data-herb-empty hidden>
        <strong>찾는 허브가 없습니다</strong>
        다른 이름으로 찾아보거나, 괄호 속 이름(예: 타임, 레몬밤)으로도 찾아보세요.
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .herbs {
    padding-top: 2rem;
  }

  .herbs__count {
    font-size: var(--t-sm);
    color: var(--ink-3);
    margin-bottom: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .herbs__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .herb-card {
    display: block;
  }

  .herb-card__img {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--snow);
    display: grid;
    place-items: center;
    color: var(--herb);
  }

  .herb-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .herb-card:hover .herb-card__img img {
    transform: scale(1.05);
  }

  .herb-card__body {
    padding-top: 0.9rem;
  }

  .herb-card__body h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s;
  }

  .herb-card:hover h2 {
    color: var(--blue);
  }

  .herb-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .herb-card__tags li {
    font-size: var(--t-xs);
    color: var(--herb);
    background: var(--herb-wash);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
  }

  @media (width <= 560px) {
    .herbs__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 0.9rem;
    }

    .herb-card__body h2 {
      font-size: var(--t-md);
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-herb-search] input');
  const items = [...document.querySelectorAll<HTMLElement>('[data-herb-list] > li')];
  const count = document.querySelector('[data-herb-count]');
  const empty = document.querySelector<HTMLElement>('[data-herb-empty]');
  const total = items.length;

  const normalize = (s: string) => s.replace(/\s+/g, '').toLowerCase();

  const apply = () => {
    const q = normalize(input?.value ?? '');
    let shown = 0;
    for (const li of items) {
      const hit = !q || normalize(li.dataset.name ?? '').includes(q);
      li.hidden = !hit;
      if (hit) shown++;
    }
    if (count) count.textContent = q ? `${total}가지 중 ${shown}가지` : `${total}가지`;
    if (empty) empty.hidden = shown > 0;
  };

  input?.addEventListener('input', apply);
  // 뒤로 가기로 돌아왔을 때 남아 있는 검색어 반영
  apply();
</script>
