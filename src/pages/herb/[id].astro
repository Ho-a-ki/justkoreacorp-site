---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getHerbs, coverOf, neighbors, startsWithCover, vt } from '../../lib/content';

export async function getStaticPaths() {
  const herbs = await getHerbs();
  return herbs.map((herb) => ({ params: { id: herb.id }, props: { herb, herbs } }));
}

const { herb, herbs } = Astro.props;
const { Content } = await render(herb);
const cover = coverOf(herb);
const { prev, next } = neighbors(herbs, herb.id);
const hideFirstImage = startsWithCover(herb);
---

<BaseLayout title={herb.data.name} description={`${herb.data.name} — JUST 허브 백과사전`} image={cover || undefined}>
  <article class="herb">
    <div class="container herb__grid">
      <aside class="herb__aside">
        <a href="/herb" class="herb__back"><Icon name="arrow-left" size={16} /> 허브 백과사전</a>
        <div class="herb__img" style={`view-transition-name:${vt('herb', herb.id)}`}>
          {cover ? <img src={cover} alt={herb.data.name} decoding="async" /> : <Icon name="leaf" size={48} />}
        </div>
      </aside>

      <div class="herb__main">
        <p class="mark">허브 백과사전</p>
        <h1 class="herb__title">{herb.data.name}</h1>
        {
          herb.data.tags.length > 0 && (
            <ul class="herb__tags">
              {herb.data.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
        <div class:list={['prose herb__prose', { 'hide-first-image': hideFirstImage }]}>
          <Content />
        </div>
      </div>
    </div>

    <nav class="container pager" aria-label="다른 허브">
      {
        prev ? (
          <a href={`/herb/${prev.id}`} class="pager__link">
            <span>이전 허브</span>
            <strong>{prev.data.name}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/herb/${next.id}`} class="pager__link pager__link--next">
            <span>다음 허브</span>
            <strong>{next.data.name}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .herb {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) var(--section);
  }

  .herb__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .herb__aside {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .herb__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 1.25rem;
  }

  .herb__back:hover {
    color: var(--blue);
  }

  .herb__img {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--snow);
    display: grid;
    place-items: center;
    color: var(--herb);
  }

  .herb__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .herb__main {
    padding-top: 2.75rem;
  }

  .herb__title {
    margin-top: 0.9rem;
    font-size: var(--t-3xl);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .herb__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .herb__tags li {
    font-size: var(--t-xs);
    color: var(--herb);
    background: var(--herb-wash);
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
  }

  .herb__prose {
    margin-top: 2rem;
  }

  .hide-first-image > :global(p:first-child:has(> img:only-child)) {
    display: none;
  }

  .hide-first-image > :global(p:first-child:has(> img:only-child) + *) {
    margin-top: 0;
  }

  /* 앞뒤 글 */
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pager__link {
    display: grid;
    gap: 0.15rem;
    max-width: 48%;
  }

  .pager__link span {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .pager__link strong {
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s;
  }

  .pager__link:hover strong {
    color: var(--blue);
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }

  @media (width <= 860px) {
    .herb__grid {
      grid-template-columns: 1fr;
    }

    .herb__aside {
      position: static;
    }

    .herb__img {
      aspect-ratio: 16 / 11;
    }

    .herb__main {
      padding-top: 0;
    }
  }
</style>
