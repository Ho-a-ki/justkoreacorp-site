---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getActivities, getHerbs, getPress, getFaqGroups, coverOf, formatDate, isoDate, displayName } from '../lib/content';
import storeData from '../data/stores.json';

const [herbs, activities, press, faqGroups] = await Promise.all([getHerbs(), getActivities(), getPress(), getFaqGroups()]);
const herbHref = (name: string) => {
  const found = herbs.find((h) => h.data.name === name || h.data.name.startsWith(name + '(') || h.data.name.includes(`(${name})`));
  return found ? `/herb/${found.id}` : '/herb';
};

// 메인 표본판: 누끼 이미지가 있는 허브 8종. 속(屬) 이름은 표본 라벨처럼 함께 적는다
const specimens = [
  { name: '에델바이스', genus: 'Leontopodium', desc: '알프스 고산의 항산화, 피부 보호', img: '/images/herbs/edelweiss.png' },
  { name: '세이지', genus: 'Salvia', desc: '맑은 피부를 위한 정화', img: '/images/herbs/sage.png' },
  { name: '백리향', genus: 'Thymus', desc: '따뜻한 온기와 편안한 호흡감', img: '/images/herbs/thyme.png' },
  { name: '티트리', genus: 'Melaleuca', desc: '피부 진정과 청결', img: '/images/herbs/teatree.png' },
  { name: '아욱', genus: 'Malva', desc: '보습과 부드러운 피부결', img: '/images/herbs/mallow.png' },
  { name: '레몬밤', genus: 'Melissa', desc: '마음을 가라앉히는 향', img: '/images/herbs/lemonbalm.png' },
  { name: '노간주', genus: 'Juniperus', desc: '순환과 근육 이완 마사지', img: '/images/herbs/juniper.png' },
  { name: '유칼립투스', genus: 'Eucalyptus', desc: '시원한 청량감', img: '/images/herbs/eucalyptus.png' },
];

const facts = [
  { value: 'ISO 3종', text: '품질경영(9001) · 화장품 GMP(22716) · 환경경영(14001) 국제 인증' },
  { value: '연 7,500건', text: '원료 입고부터 완제품까지, 자사 연구소에서 하는 품질 검사' },
  { value: '동물실험 없음', text: '창립 때부터 지금까지, 그리고 앞으로도 지키는 원칙' },
];

const faqCount = faqGroups.reduce((n, g) => n + g.items.length, 0);
const destinations = [
  { href: '/stores', title: '가까운 매장 찾기', meta: `전국 ${storeData.stores.length}곳` },
  { href: '/herb', title: '허브 백과사전', meta: `${herbs.length}가지 원료` },
  { href: '/faq', title: '자주 묻는 질문', meta: `${faqCount}개 답변` },
  { href: 'https://spa.justkoreacorp.com/', title: '유스트 스파 예약', meta: '외부 사이트', external: true },
];

const latestActivities = activities.slice(0, 3);
const latestPress = press.slice(0, 4);
const alpenrose = herbHref('알펜로즈');
---

<BaseLayout overlayHeader>
  <!-- 첫 화면 -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <img src="/images/hero/banner.jpg" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="container hero__content">
      <p class="hero__origin">
        <svg class="hero__cross" viewBox="0 0 32 32" aria-hidden="true">
          <rect class="hero__cross-bg" width="32" height="32" />
          <path class="hero__cross-v" d="M16 7v18" />
          <path class="hero__cross-h" d="M7 16h18" />
        </svg>
        <span>1930년, 스위스 아펜첼에서</span>
      </p>
      <h1 class="hero__title" id="hero-title">
        <span class="hero__line"><span>알프스의 허브를</span></span>
        <span class="hero__line"><span>스위스의 방식으로</span></span>
      </h1>
      <p class="hero__desc">
        유스트코리아는 스위스 허브 코스메틱 JUST의 한국 공식 법인입니다. 스위스 자사 공장에서 만든 제품을 매장과 스파, 온라인으로 전합니다.
      </p>
      <div class="hero__actions">
        <a href="/stores" class="btn btn--light">가까운 매장 찾기 <Icon name="arrow" size={18} /></a>
        <a href="/herb" class="btn btn--glass">허브 백과사전</a>
      </div>
    </div>
    <a href={alpenrose} class="hero__caption">
      <Icon name="leaf" size={14} />
      사진 속 분홍 꽃은 JUST의 원료인 알펜로즈입니다
    </a>
  </section>

  <!-- 스위스 제조 -->
  <section class="section made">
    <div class="container made__grid">
      <div class="made__head">
        <p class="mark">Made in Switzerland</p>
        <h2 class="heading">발첸하우젠의 자사 연구소와 공장에서 직접 만듭니다</h2>
      </div>
      <dl class="made__facts">
        {
          facts.map((f) => (
            <div class="made__fact">
              <dt>{f.value}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 허브 표본판 -->
  <section class="section section--snow specimens" aria-labelledby="specimens-title">
    <div class="container">
      <div class="specimens__head">
        <h2 class="heading" id="specimens-title">한 병에 담기는 허브들</h2>
        <p class="lede">스위스 고유의 허브와 세계 곳곳의 원료를 연구소에서 하나씩 검증해 씁니다. 허브를 누르면 자세한 이야기가 열립니다.</p>
      </div>
      <ul class="specimens__grid">
        {
          specimens.map((s) => (
            <li class="reveal">
              <a href={herbHref(s.name)} class="specimen">
                <div class="specimen__img">
                  <img src={s.img} alt="" loading="lazy" decoding="async" />
                </div>
                <div class="specimen__label">
                  <strong>{s.name}</strong>
                  <em lang="la">{s.genus}</em>
                  <span>{s.desc}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/herb" class="text-link specimens__all">허브 {herbs.length}가지 모두 보기 <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- 철학 -->
  <section class="section philosophy">
    <div class="container philosophy__grid">
      <div class="philosophy__media">
        <img class="philosophy__main" src="/images/philosophy/flowers.jpg" alt="알프스 들판에 가득 핀 에델바이스" loading="lazy" decoding="async" />
        <img class="philosophy__sub" src="/images/philosophy/scientist.jpg" alt="연구소에서 원료의 향을 확인하는 연구원" loading="lazy" decoding="async" />
        <img class="philosophy__bottle" src="/images/philosophy/oil-bottle.png" alt="JUST 31 허브 에센셜 오일" loading="lazy" decoding="async" />
      </div>
      <div class="philosophy__text">
        <p class="mark">원료를 고르는 기준</p>
        <blockquote class="philosophy__quote">
          <p>가능한 한 적게,<br />필요한 만큼만.</p>
          <footer lang="en">As little as possible, as much as necessary.</footer>
        </blockquote>
        <p>
          JUST의 모든 성분은 쓰기 전에 자사 연구소에서 안전성과 효과, 안정성을 먼저 확인합니다. 동물 유래 원료는 왁스와 꿀, 우유 말고는 쓰지 않습니다.
        </p>
        <p>
          제품은 세계에서 가장 엄격한 화장품 규정 중 하나인 EU 화장품 규정(EC 1223/2009)에 맞춰 만들고, 스위스 국기를 달고 나옵니다.
        </p>
        <a href="/faq#faq-001" class="text-link">제품 안전에 대해 더 읽기 <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 최근 소식 -->
  <section class="section section--snow news" aria-labelledby="news-title">
    <div class="container">
      <h2 class="heading news__title" id="news-title">최근 소식</h2>
      <div class="news__grid">
        <div class="news__col">
          <div class="news__col-head">
            <h3>주요 활동</h3>
            <a href="/activities" class="text-link">전체 보기 <Icon name="arrow" size={16} /></a>
          </div>
          <ul class="news__list">
            {
              latestActivities.map((a) => (
                <li>
                  <a href={`/activities/${a.id}`} class="news__item">
                    <time datetime={isoDate(a.data.date)}>{formatDate(a.data.date)}</time>
                    <strong>{a.data.summary || a.data.title}</strong>
                    {a.data.category && <span class="news__cat">{a.data.category}</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="news__col">
          <div class="news__col-head">
            <h3>미디어에 소개된 JUST</h3>
            <a href="/press" class="text-link">전체 보기 <Icon name="arrow" size={16} /></a>
          </div>
          <ul class="news__press">
            {
              latestPress.map((p) => (
                <li>
                  <a href={`/press/${p.id}`} class="press-mini">
                    <div class="press-mini__img">
                      {coverOf(p) && <img src={coverOf(p)} alt="" loading="lazy" decoding="async" />}
                    </div>
                    <span>{displayName(p.data.name)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 바로 가기 -->
  <section class="section destinations" aria-label="바로 가기">
    <div class="container">
      <ul class="dest">
        {
          destinations.map((d) => (
            <li>
              <a
                href={d.href}
                class="dest__row"
                target={d.external ? '_blank' : undefined}
                rel={d.external ? 'noopener' : undefined}
              >
                <span class="dest__title">{d.title}</span>
                <span class="dest__meta">{d.meta}</span>
                <span class="dest__icon">
                  <Icon name={d.external ? 'external' : 'arrow'} size={22} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 문의 -->
  <section class="contact-band">
    <div class="container contact-band__inner">
      <h2 class="heading">제품 상담은 채팅으로,<br />협업 제안은 메일로 받습니다</h2>
      <div class="contact-band__actions">
        <a href="https://happytalk.io/l/quU0Cb" class="btn btn--light" target="_blank" rel="noopener">
          <Icon name="chat" size={18} /> 채팅 상담 열기
        </a>
        <a href="/contact" class="btn btn--glass">협업 문의 보내기</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── 첫 화면 ─────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: max(36rem, 100svh);
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(0 30 60 / 0.45) 0%, transparent 22%),
      linear-gradient(20deg, rgb(0 38 77 / 0.88) 0%, rgb(0 38 77 / 0.45) 45%, transparent 75%);
  }

  .hero__content {
    padding-block: calc(var(--nav-h) + 4rem) clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  .hero__origin {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__cross {
    width: 1.75rem;
    height: 1.75rem;
    transform: skewX(-10deg);
    overflow: visible;
  }

  .hero__cross-bg {
    fill: var(--red);
  }

  .hero__cross-v,
  .hero__cross-h {
    stroke: var(--white);
    stroke-width: 6;
    fill: none;
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 1rem + 7.4vw, 7.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.055em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__line > span {
    display: inline-block;
  }

  .hero__desc {
    margin-top: 1.75rem;
    max-width: 32rem;
    font-size: var(--t-lg);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.86);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__caption {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-xs);
    color: rgb(255 255 255 / 0.78);
    transition: color 0.2s;
  }

  .hero__caption:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* 첫 화면 등장 — 이 페이지에서 유일하게 저절로 움직이는 순간 */
  @media (prefers-reduced-motion: no-preference) {
    .hero__media img {
      animation: hero-zoom 2.6s var(--ease-out) both;
    }

    .hero__cross-bg {
      transform-origin: center;
      animation: cross-pop 0.6s var(--ease-out) 0.25s both;
    }

    .hero__cross-v,
    .hero__cross-h {
      stroke-dasharray: 18;
      animation: cross-draw 0.45s var(--ease-in-out) both;
    }

    .hero__cross-v {
      animation-delay: 0.6s;
    }

    .hero__cross-h {
      animation-delay: 0.75s;
    }

    .hero__origin span {
      animation: fade-in 0.6s var(--ease-out) 0.7s both;
    }

    .hero__line > span {
      animation: line-up 1s var(--ease-out) both;
    }

    .hero__line:nth-child(1) > span {
      animation-delay: 0.45s;
    }

    .hero__line:nth-child(2) > span {
      animation-delay: 0.58s;
    }

    .hero__desc,
    .hero__actions,
    .hero__caption {
      animation: fade-up 0.9s var(--ease-out) both;
    }

    .hero__desc {
      animation-delay: 0.85s;
    }

    .hero__actions {
      animation-delay: 0.95s;
    }

    .hero__caption {
      animation-delay: 1.4s;
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes cross-pop {
    from {
      transform: scale(0);
    }
  }

  @keyframes cross-draw {
    from {
      stroke-dashoffset: 18;
    }
  }

  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* ── 스위스 제조 ─────────────────────────────────── */
  .made__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 3rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .made__head .heading {
    margin-top: 1rem;
  }

  .made__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink);
  }

  .made__fact {
    padding: 1.5rem 1.5rem 0 0;
  }

  .made__fact + .made__fact {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .made__fact dt {
    font-size: var(--t-xl);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue);
    line-height: 1.2;
  }

  .made__fact dd {
    margin-top: 0.6rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1.65;
  }

  /* ── 허브 표본판 ─────────────────────────────────── */
  .specimens__head {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 4vw, 4rem);
  }

  .specimens__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .specimens__grid li:nth-child(4n + 2) {
    animation-range: entry 10% cover 33%;
  }

  .specimens__grid li:nth-child(4n + 3) {
    animation-range: entry 15% cover 38%;
  }

  .specimens__grid li:nth-child(4n + 4) {
    animation-range: entry 20% cover 43%;
  }

  .specimen {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    transition: background-color 0.3s;
  }

  .specimen__img {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 12%;
  }

  .specimen__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 18px rgb(15 34 54 / 0.12));
    transition: transform 0.7s var(--ease-out);
  }

  .specimen:hover .specimen__img img {
    transform: rotate(-4deg) scale(1.06);
  }

  .specimen:hover {
    background: color-mix(in srgb, var(--herb-wash) 55%, var(--white));
  }

  .specimen__label {
    display: grid;
    gap: 0.15rem;
    padding: 0 1.25rem 1.4rem;
    margin-top: auto;
  }

  .specimen__label strong {
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .specimen__label em {
    font-size: var(--t-xs);
    color: var(--herb);
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .specimen__label span {
    font-size: var(--t-sm);
    color: var(--ink-2);
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .specimens__all {
    margin-top: 2rem;
  }

  /* ── 철학 ────────────────────────────────────────── */
  .philosophy__grid {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 3rem clamp(2rem, 7vw, 7rem);
    align-items: center;
  }

  .philosophy__media {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(12, minmax(0, 1fr));
    aspect-ratio: 1 / 1.08;
  }

  .philosophy__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .philosophy__main {
    grid-column: 1 / 10;
    grid-row: 1 / 12;
    border-radius: var(--r-md);
  }

  .philosophy__sub {
    grid-column: 7 / 13;
    grid-row: 7 / 13;
    border-radius: var(--r-md);
    border: 6px solid var(--white);
    box-shadow: 0 24px 50px -20px rgb(15 34 54 / 0.35);
  }

  .philosophy__bottle {
    grid-column: 9 / 12;
    grid-row: 1 / 7;
    object-fit: contain !important;
    filter: drop-shadow(0 22px 20px rgb(15 34 54 / 0.35));
    transform: translateY(8%);
  }

  .philosophy__text > * + * {
    margin-top: 1.1rem;
  }

  .philosophy__text > p:not(.mark) {
    color: var(--ink-2);
  }

  .philosophy__quote {
    margin-top: 1.5rem !important;
    margin-bottom: 2rem;
  }

  .philosophy__quote p {
    font-size: var(--t-2xl);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.15;
    color: var(--blue);
  }

  .philosophy__quote footer {
    margin-top: 0.75rem;
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--ink-3);
  }

  .philosophy__text .text-link {
    margin-top: 1.75rem;
  }

  /* ── 최근 소식 ───────────────────────────────────── */
  .news__title {
    margin-bottom: 2.5rem;
  }

  .news__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
