---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getActivities, coverOf, formatDate, isoDate, neighbors } from '../../lib/content';

export async function getStaticPaths() {
  const activities = await getActivities();
  return activities.map((activity) => ({ params: { id: activity.id }, props: { activity, activities } }));
}

const { activity, activities } = Astro.props;
const { Content } = await render(activity);
const { prev, next } = neighbors(activities, activity.id);
const title = activity.data.title;
---

<BaseLayout title={title} description={activity.data.summary || title} image={coverOf(activity) || undefined}>
  <article class="article">
    <header class="container article__head">
      <a href="/activities" class="article__back"><Icon name="arrow-left" size={16} /> 주요 활동</a>
      <div class="article__meta">
        <time datetime={isoDate(activity.data.date)}>{formatDate(activity.data.date)}</time>
        {activity.data.category && <span>{activity.data.category}</span>}
      </div>
      <h1 class="article__title">{title}</h1>
      {activity.data.summary && <p class="article__summary">{activity.data.summary}</p>}
    </header>

    <div class="container article__body prose">
      <Content />
    </div>

    <nav class="container pager" aria-label="다른 활동">
      {
        prev ? (
          <a href={`/activities/${prev.id}`} class="pager__link">
            <span>다음 활동</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/activities/${next.id}`} class="pager__link pager__link--next">
            <span>지난 활동</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) var(--section);
  }

  .article__head,
  .article__body,
  .pager {
    max-width: calc(46rem + var(--gutter) * 2);
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 2rem;
  }

  .article__back:hover {
    color: var(--blue);
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .article__meta span {
    font-size: var(--t-xs);
    font-weight: 600;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .article__title {
    margin-top: 1rem;
    font-size: var(--t-2xl);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .article__summary {
    margin-top: 1rem;
    font-size: var(--t-lg);
    color: var(--ink-2);
  }

  .article__body {
    margin-top: 3rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: var(--section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pager__link {
    display: grid;
    gap: 0.15rem;
    max-width: 48%;
  }

  .pager__link span {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .pager__link strong {
    font-weight: 650;
    line-height: 1.5;
    transition: color 0.2s;
  }

  .pager__link:hover strong {
    color: var(--blue);
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }
</style>
