---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getActivities, coverOf, formatMonthDay, isoDate } from '../../lib/content';

const activities = await getActivities();
const yearOf = (d: Date) => Number(isoDate(d).slice(0, 4));
const years = [...new Set(activities.map((a) => yearOf(a.data.date)))];
const categories = [...new Set(activities.map((a) => a.data.category).filter(Boolean))] as string[];
---

<BaseLayout title="주요 활동" description="수상, 강연, 행사와 나눔까지 유스트코리아가 걸어온 일들입니다.">
  <PageHeader section="주요 활동" title="유스트코리아가 걸어온 일" description="상을 받고, 강연을 하고, 사람들을 만난 기록입니다." />

  <section class="section timeline-wrap">
    <div class="container">
      {
        categories.length > 1 && (
          <div class="chips filters" role="group" aria-label="구분으로 거르기" data-filters>
            <button class="chip" aria-pressed="true" data-cat="">
              전체 <span class="chip__count">{activities.length}</span>
            </button>
            {categories.map((c) => (
              <button class="chip" aria-pressed="false" data-cat={c}>
                {c} <span class="chip__count">{activities.filter((a) => a.data.category === c).length}</span>
              </button>
            ))}
          </div>
        )
      }

      {
        years.map((year) => (
          <section class="year" data-year>
            <h2 class="year__label">{year}</h2>
            <ol class="year__list">
              {activities
                .filter((a) => yearOf(a.data.date) === year)
                .map((a) => {
                  const cover = coverOf(a);
                  return (
                    <li data-cat={a.data.category ?? ''}>
                      <a href={`/activities/${a.id}`} class="entry">
                        <time datetime={isoDate(a.data.date)}>{formatMonthDay(a.data.date)}</time>
                        <div class="entry__text">
                          {a.data.category && <span class="entry__cat">{a.data.category}</span>}
                          <h3>{a.data.title}</h3>
                          {a.data.summary && <p>{a.data.summary}</p>}
                        </div>
                        <div class="entry__img">{cover && <img src={cover} alt="" loading="lazy" decoding="async" />}</div>
                      </a>
                    </li>
                  );
                })}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .timeline-wrap {
    padding-top: 2.5rem;
  }

  .filters {
    margin-bottom: 3rem;
  }

  .year {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem 2rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--ink);
  }

  .year + .year {
    margin-top: 4rem;
  }

  .year__label {
    font-size: var(--t-2xl);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    align-self: start;
  }

  .year__list {
    list-style: none;
  }

  .year__list li + li .entry {
    border-top: 1px solid var(--line);
  }

  .entry {
    display: grid;
    grid-template-columns: 6.5rem 1fr 11rem;
    gap: 1.5rem;
    padding-block: 0 1.75rem;
    align-items: start;
  }

  .year__list li + li .entry {
    padding-top: 1.75rem;
  }

  .entry time {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .entry__cat {
    display: inline-block;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-2);
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .entry h3 {
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s;
  }

  .entry:hover h3 {
    color: var(--blue);
  }

  .entry__text p {
    margin-top: 0.45rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.65;
  }

  .entry__img {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--snow);
  }

  .entry__img:empty {
    background: none;
  }

  .entry__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }

  .entry:hover .entry__img img {
    transform: scale(1.05);
  }

  [hidden] {
    display: none !important;
  }

  @media (width <= 860px) {
    .year {
      grid-template-columns: 1fr;
    }

    .year__label {
      position: static;
    }

    .entry {
      grid-template-columns: 1fr 7rem;
      gap: 0.4rem 1rem;
    }

    .entry time {
      grid-column: 1 / -1;
    }

    .entry__img {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>

<script>
  const group = document.querySelector('[data-filters]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filters] .chip')];
  const years = [...document.querySelectorAll<HTMLElement>('[data-year]')];

  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!btn) return;
    const cat = btn.dataset.cat ?? '';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const update = () => {
      for (const year of years) {
        const items = [...year.querySelectorAll<HTMLElement>('li[data-cat]')];
        items.forEach((li) => (li.hidden = Boolean(cat) && li.dataset.cat !== cat));
        year.hidden = items.every((li) => li.hidden);
      }
    };
    // 지원하면 목록이 부드럽게 바뀐다
    document.startViewTransition ? document.startViewTransition(update) : update();
  });
</script>
